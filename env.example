########################################
# Service ports and urls               #
########################################
#
# Most of these can be kept as is.
# You probably only need to change these ports if you run multiple
# services simultaneously on your local dev machine.
#

# Internal http api port
HTTP_PORT=8080

# Internal grpc port
GRPC_PORT=8081

# Internal http web port 
WEB_PORT=8000

# Path prefix for the http web endpoints
WEB_PATH_PREFIX=/web

# Registration mode: "open" (anyone can register) or "invite_only" (admin must
# invite an email address before that user can register).
REGISTRATION_MODE=open

# URL of the registration page sent in invitation emails.
# Only used when REGISTRATION_MODE=invite_only.
# Set to the public-facing URL that invited users should open to register.
# In local dev this is typically the authservice web server's register page.
REGISTRATION_URL=http://localhost:8000/web/register

# Default URL for email verification links.
# Used when the caller (mobile app, web frontend) does not supply a verificationUrl
# in the request body. Leave empty to require the caller to always provide it.
VERIFICATION_URL=http://localhost:8000/web/verify-user

# Default URL for password reset links.
# Used when the caller does not supply a resetUrl in the request body.
# Leave empty to require the caller to always provide it.
RESET_PASSWORD_URL=http://localhost:8000/web/reset-password


########################################
# Database configuration              #
########################################
#
# Connection details to the postgres database
# Set these values to match your local development database
#
DB_HOST=127.0.0.1
DB_PORT=35432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=authdb
DB_SSL_MODE=disable


########################################
# Credentials of the built-in admin    #
########################################
#
# On production those values should be set to a real admin user and you
# should use a strong password
#
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=MyStrongPassword123


########################################
# Mail service configuration           #
########################################
#
# Configuration for the mail service
#

# The address used to send mails from.
# Set this to a valid email address, supported by the underlying mail
# server.
MAILER_ADDRESS=swayrider@example.com

# The hostname of the mail service
MAILSERVICE_HOST=mailservice.example.com

# The gRPC port of the mail service
MAILSERVICE_PORT=8081

########################################
# Cookie namespace                     #
########################################
#
# Prefix applied to all cookie names to avoid conflicts with other apps.
# Override only when deploying under a different brand/domain namespace.
#
#COOKIE_NAMESPACE=com.hevanto-it.swayrider

########################################
# Cookie SameSite policy               #
########################################
#
# SameSite policy applied to the refresh-token cookie.
# Valid values: strict, lax (case-insensitive). Defaults to strict.
# "none" is not supported (it requires Secure, which is derived per request).
#
#COOKIE_SAMESITE=strict

########################################
# Rate limiting                        #
########################################
#
# Coarse per-source-IP rate limit applied to both the gRPC port and the
# HTTP/REST gateway. A safety net in case a service is ever reached directly
# by more callers than expected.
#

RATE_LIMIT_RPS=50
RATE_LIMIT_BURST=100
RATE_LIMIT_IDLE_TTL_SECS=300

########################################
# Health checks                        #
########################################
#
# How long a health probe result is cached before the service re-pings the
# database, so orchestrator health checks don't hammer the database.
#

HEALTH_PROBE_TTL_SECS=15

########################################
# Password breach detection (HIBP)     #
########################################
#
# Registration, password change and password reset reject passwords that have
# appeared in a known data breach, checked against the Have I Been Pwned
# Pwned Passwords API (https://haveibeenpwned.com/Passwords).
# Privacy-preserving k-anonymity: only the first 5 chars of the SHA-1 hash
# leave the server; the password itself never does. The check fails open -- an
# HIBP outage or timeout never blocks users.
#

# Enable breach checks (disable to turn the feature off entirely)
HIBP_ENABLED=true

# Timeout for Pwned Passwords API requests, in milliseconds
HIBP_TIMEOUT_MS=3000

# Minimum number of times a password must appear in breach data to be rejected
HIBP_MIN_COUNT=1

########################################
# Password history (reuse prevention)  #
########################################
#
# The last N password hashes per user are kept so password change and reset
# reject reusing a recent password. The hash of every newly-set password is
# recorded (registration seeds it, change/reset append it). History writes and
# checks fail open -- a history outage never blocks users.
#

# How many recent password hashes per user to keep
PASSWORD_HISTORY_SIZE=5
